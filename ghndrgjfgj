local function SaveConfig(cfgName)
    if not writefile then return end
    cfgName = (cfgName == "" or not cfgName) and "default" or cfgName
    local saveTable = {}
    for k, v in pairs(Config) do
        if typeof(v) == "Color3" then saveTable[k] = {Type = "Color3", R = v.R, G = v.G, B = v.B}
        elseif typeof(v) == "EnumItem" or (type(v) == "userdata" and tostring(v):match("^Enum%.")) then
            local parts = string.split(tostring(v), ".")
            if #parts >= 3 then saveTable[k] = {Type = "Enum", EnumType = parts[2], Name = parts[3]} end
        else saveTable[k] = v end
    end
    if not isfolder(FOLDER_NAME) then makefolder(FOLDER_NAME) end
    writefile(FOLDER_NAME.."/"..cfgName..".json", HttpService:JSONEncode(saveTable))
    if RefreshConfigs then RefreshConfigs() end
end

